---
import ContactForm from "../common/Contact_Form.astro";
---

<section class="section-dark">
    <div class="container">
        <div class="contact-head">
            <h2>Get in Touch With The Central Coast PVC Experts</h2>
            <p>
                Have questions about one of our recent projects or want to learn
                more about PVC fencing for your own property? Our friendly team
                is here to help with expert advice, quotes, and guidance on the
                best fencing solutions for your home. We service the entire
                Central Coast region with professional, reliable PVC fence and
                gate installations you can count on.
            </p>
        </div>
        <div class="form">
            <ContactForm />
        </div>

        <div class="contact-information">
            <div class="info-header">
                <h3>Contact Us Directly</h3>
                <p>
                    Want to speak with someone now? Call or message us for fast,
                    friendly support, no call centres, no delays.
                </p>
            </div>

            <div class="info">
                <h4>Phone</h4>
                <a href="tel:0405 105 855">0405 105 855</a>
            </div>

            <div class="info">
                <h4>Email</h4>
                <a href="mailto:info@pvcfencingcentralcoast.com"
                    >info@pvcfencingcentralcoast.com</a
                >
            </div>
        </div>
    </div>
</section>

<style>
    .container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .contact-information {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-top: 4rem;
    }
    .contact-head {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .info-header {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .info :global(h4) {
        margin-top: 0px;
        margin-bottom: 1rem;
    }

    @media (min-width: 768px) {
        .contact-head {
            grid-area: contact-head;
        }
        .form {
            grid-area: form;
            margin-top: 3rem;
        }
        .contact-information {
            margin-top: 3rem;
            grid-area: info;
            box-shadow: var(--box-shadow);
            padding: 1rem;
            height: fit-content;
        }
        .container {
            display: grid;
            grid-template-columns: 0.8fr 1fr;
            grid-template-areas:
                "contact-head contact-head"
                "info form";
            gap: 2rem;
        }
    }

    @media (min-width: 1024px) {
        .container {
            row-gap: 4rem;
        }

        .contact-head {
            gap: 4rem;
        }
    }

    @media (min-width: 1440px) {
        .contact-information {
            padding: 2rem;
        }
    }
</style>
