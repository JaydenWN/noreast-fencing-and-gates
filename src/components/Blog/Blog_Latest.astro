---
import BlogPreviewCard from "./Blog_Preview_Card.astro";

const { blogPosts } = Astro.props;
---

<section>
    <div class="container">
        <h2>See Our Latest PVC Fencing Projects and Articles</h2>
        <p>
            Browse through our recent PVC fencing installations, automatic gate
            projects and expert tips. Each post showcases the quality
            craftsmanship and attention to detail that Noreast Fencing and Gates
            is known for across the Central Coast.
        </p>
        <div class="cards">
            {blogPosts.map((post) => <BlogPreviewCard post={post} />)}
        </div>
    </div>
</section>

<style>
    .container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .cards {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    @media (min-width: 768px) {
        .cards {
            display: grid;
            grid-template-columns: 1fr 1fr;
            row-gap: 1rem;
            margin-top: 2rem;
        }
        .container {
            gap: 2rem;
        }
    }

    @media (min-width: 1024px) {
        .cards {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (min-width: 1440px) {
        p {
            max-width: 730px;
            text-align: center;
            margin: 0px auto;
        }
    }
</style>
