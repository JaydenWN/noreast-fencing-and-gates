---
import Button from "../common/Button.astro";
import PhoneIcon from "@icons/call-white.svg";
import QuoteIcon from "@icons/quote-white.svg";
import { Image } from "astro:assets";
const { title, date, image, width, height, description } = Astro.props;
---

<header>
    <div class="container">
        <h1>{title}</h1>
        <small class="date">{date}</small>
        <Image
            src={image}
            height={height}
            width={width}
            alt={title}
            class="image"
        />
        <p>{description}</p>
        <div class="cta-buttons">
            <Button href="tel:0405 105 855" type="secondary-dark"
                ><PhoneIcon />Call Us</Button
            >
            <Button href="/contact/#contact" type="primary"
                ><QuoteIcon />Request a quote</Button
            >
        </div>
    </div>
</header>

<style>
    header {
        background-color: var(--dark-blue);
        color: white;
        box-sizing: border-box;
    }
    h1 {
        color: white;
        text-transform: uppercase;
        line-height: 100%;
        font-size: 2.3em;
    }
    .container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .cta-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .image {
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 3px;
        margin-top: -1rem;
    }
    .date {
        text-align: right;
    }

    @media (min-width: 768px) {
        .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }
        h1 {
            grid-column: 1 / 3;
            margin-bottom: 2rem;
            font-size: 2.6em;
        }
        .image {
            grid-column: 2 / 3;
            grid-row: 2 / 4;
        }
        .container p {
            grid-column: 1 / 2;
            grid-row: 2 / 3;
        }
        .cta-buttons {
            grid-row: 3 / 4;
            grid-column: 1 / 2;
            flex-wrap: wrap;
        }
        .date {
            grid-column: 2 / 3;
        }
        .cta-buttons > :global(a) {
            max-height: fit-content;
            margin-top: auto;
        }
    }

    @media (min-width: 1440px) {
        .container {
            grid-template-columns: 1fr 40%;
            column-gap: 4rem;
        }
        h1 {
            grid-column: 1 / 2;
        }
        .image {
            grid-row: 1 / 4;
        }
    }
</style>
