---
import { Image } from "astro:assets";
import Button from "../common/Button.astro";
const { post } = Astro.props;
---

<div class="card">
    <Image
        src={post.previewImage.fields.file.url}
        alt={post.title}
        width={300}
        height={200}
        class="image"
    />
    <h3>{post.title}</h3>

    {
        post.description.length > 169 ? (
            <p>{post.description.slice(0, 169)}...</p>
        ) : (
            <p>{post.description}</p>
        )
    }
    <Button href=`/blog/${post.slug}` type="primary">Read More</Button>
</div>

<style>
    .card {
        padding: 1rem;
        background-color: var(--background-blue);
        border-radius: 3px;
        box-shadow: var(--box-shadow);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .card h3 {
        font-size: 1.26em;
    }
    .image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 3px;
        box-shadow: var(--box-shadow);
    }

    @media (min-width: 768px) {
        .card {
            display: grid;
            grid-template-rows: subgrid;
            grid-row: span 4;
        }
    }

    @media (min-width: 1024px) {
        .card {
            row-gap: 1rem;
        }
    }
</style>
