---
import { contentfulClient } from "../../lib/contentful";
import type { BlogPost } from "../../lib/contentful";
import LandingLatestJobCard from "./Landing_Latest_Job_Card.astro";

const entries = await contentfulClient.getEntries<BlogPost>({
    content_type: "blogPost",
});

const posts = entries.items.map((item) => {
    const { title, date, description, slug, previewImage } = item.fields;
    return {
        title,
        slug,
        description,
        date: new Date(date),
        previewImage,
    };
});

// Sort by date (newest first)
const sortedPosts = posts.sort((a, b) => b.date.getTime() - a.date.getTime());

// Take only the latest 3
const latestPosts = sortedPosts.slice(0, 3);
---

<section>
    <div class="container">
        <h2>Recent PVC Fence Installations on the Central Coast</h2>
        <p>
            At Noreast Fencing and Gates, we take pride in every project we
            complete across the Central Coast. From Hamptons-style PVC front
            fences to durable privacy fencing and custom gate installations, our
            latest jobs highlight the quality and attention to detail we’re
            known for. Take a look at some of our recent fencing projects below
            to see what we can create for your property.
        </p>

        <div class="cards">
            {latestPosts.map((post) => <LandingLatestJobCard post={post} />)}
        </div>
    </div>
</section>

<style>
    .container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .cards {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    @media (min-width: 768px) {
        .cards {
            display: grid;
            grid-template-columns: 1fr 1fr;
            row-gap: 1rem;
            margin-top: 2rem;
        }
    }
    @media (min-width: 1024px) {
        .cards {
            margin-top: 4rem;
            grid-template-columns: repeat(3, 1fr);
        }

        p {
            text-align: center;
            max-width: 730px;
            margin: 0px auto;
        }
        h2 {
            text-align: center;
        }
    }
</style>
